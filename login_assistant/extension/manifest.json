{
  "manifest_version": 3,
  "name": "Discord Archive 一次性绑定",
  "version": "0.1.0",
  "description": "仅在本人点击时，将当前 Discord 登录连接加密交给本机助手，绑定自己的 Ubuntu。",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://discord.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://discord.com/*"
      ],
      "js": [
        "intent.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}