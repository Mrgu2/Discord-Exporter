{
  "manifest_version": 3,
  "name": "Discord Archive 首次连接",
  "version": "0.4.0",
  "description": "本人点击后，将当前 Discord 登录连接通过本机组件加密绑定到自己的 Ubuntu。",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging",
    "webRequest"
  ],
  "action": {
    "default_title": "首次连接 Discord"
  },
  "host_permissions": [
    "https://discord.com/*"
  ],
  "background": {
    "service_worker": "launch.mjs",
    "type": "module"
  }
}
